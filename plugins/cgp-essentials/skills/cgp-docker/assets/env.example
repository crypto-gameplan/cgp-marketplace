# Copy this file to .env and fill in the values: cp .env.example .env
# .env holds your real secrets. It is in .gitignore and .dockerignore and must never be committed.

# Database. Use letters and digits only in the password; other characters break the connection URL.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Add every other variable the app reads, with a comment saying what it is and where to get it.
# EXAMPLE_API_KEY=
